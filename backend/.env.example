# Copy this file to `.env` and adjust for your machine.
# Never commit the real `.env`.

# Main application database (SQLAlchemy 2.x URL)
DATABASE_URL=postgresql+psycopg2://newtonite:newtonite@localhost:5432/newtonite

# Dedicated test database used by pytest (must be PostgreSQL, not SQLite)
TEST_DATABASE_URL=postgresql+psycopg2://newtonite:newtonite@localhost:5433/newtonite_test

# JWT settings
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=45

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# Idempotency key retention window
IDEMPOTENCY_TTL_HOURS=24
